{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shortlink",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "CLICK_COUNTER",
        "class_name": "ClickCounter"
      }
    ]
  },
  "exports": {
    "ClickCounter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db-shortlink",
      "database_id": "fc2a8b6b-4a29-4236-97a9-0f468624bf80"
    }
  ]
}
